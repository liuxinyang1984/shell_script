#!/bin/sh
# 键盘背光（Apple 等）：kbdbl up|down
# 默认设备 smc::kbd_backlight；可用 env KBD_BACKLIGHT_DEVICE=… 覆盖
set -e
step=5%
dev="${KBD_BACKLIGHT_DEVICE:-smc::kbd_backlight}"

notify() {
	command -v notify-send >/dev/null 2>&1 || return 0
	notify-send -r 9912 -t 1200 -a kbdbl "$1" "$2"
}

if ! brightnessctl -l 2>/dev/null | grep -Fq "$dev"; then
	echo "未找到键盘背光设备: $dev" >&2
	exit 1
fi

case "${1:-}" in
up)
	brightnessctl -d "$dev" set "${step}+" >/dev/null
	;;
down)
	brightnessctl -d "$dev" set "${step}-" >/dev/null
	;;
*)
	echo "用法: $(basename "$0") up|down" >&2
	exit 1
	;;
esac

pct=$(brightnessctl -d "$dev" -m 2>/dev/null | cut -d, -f4)
pct=${pct%\%}
pct=${pct:-0}

if [ "$pct" -le 0 ]; then
	icon="⌨️"
	body="关闭"
else
	icon="⌨️"
	body="${pct}%"
fi

printf '%s %s\n' "$icon" "$body"
notify "$icon" "$body"
