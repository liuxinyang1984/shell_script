#!/bin/sh
# 屏幕亮度：bright up|down（dwm / tmux / 命令行复用）
set -e
step=5%

notify() {
	command -v notify-send >/dev/null 2>&1 || return 0
	notify-send -r 9911 -t 1200 -a bright "$1" "$2"
}

case "${1:-}" in
up)
	brightnessctl set "${step}+" >/dev/null
	;;
down)
	brightnessctl set "${step}-" >/dev/null
	;;
*)
	echo "用法: $(basename "$0") up|down" >&2
	exit 1
	;;
esac

# machine-readable: name,class,value,percent,max  → percent 如 40%
pct=$(brightnessctl -m 2>/dev/null | cut -d, -f4)
pct=${pct%\%}
pct=${pct:-0}

if [ "$pct" -lt 34 ]; then
	icon="🔅"
elif [ "$pct" -lt 67 ]; then
	icon="🔆"
else
	icon="☀️"
fi
body="${pct}%"

printf '%s %s\n' "$icon" "$body"
notify "$icon" "$body"
