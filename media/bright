#!/bin/sh
# 屏幕亮度：bright up|down（通知图标为 Nerd Font）
set -e
step=5%

# Nerd Font (Material Design): brightness-5 / 6 / 7
icon_low="󰃞"
icon_mid="󰃟"
icon_high="󰃠"

notify() {
	command -v notify-send >/dev/null 2>&1 || return 0
	notify-send -r 9911 -t 1200 -a bright "$1" "$2"
}

case "${1:-}" in
up)
	brightnessctl set "${step}+" >/dev/null
	;;
down)
	brightnessctl set "${step}-" >/dev/null
	;;
*)
	echo "用法: $(basename "$0") up|down" >&2
	exit 1
	;;
esac

pct=$(brightnessctl -m 2>/dev/null | cut -d, -f4)
pct=${pct%\%}
pct=${pct:-0}

if [ "$pct" -lt 34 ]; then
	icon=$icon_low
elif [ "$pct" -lt 67 ]; then
	icon=$icon_mid
else
	icon=$icon_high
fi
body="${pct}%"

printf '%s %s\n' "$icon" "$body"
notify "$icon" "$body"
