#!/bin/sh
# 屏幕亮度：bright up|down（dwm / tmux / 命令行复用）
set -e
step=5%

notify() {
	command -v notify-send >/dev/null 2>&1 || return 0
	notify-send -r 9911 -t 1200 -a bright "亮度" "$1"
}

case "${1:-}" in
up)
	brightnessctl set "${step}+" >/dev/null
	;;
down)
	brightnessctl set "${step}-" >/dev/null
	;;
*)
	echo "用法: $(basename "$0") up|down" >&2
	exit 1
	;;
esac

# 例: "acpi_video0,backlight,40,40%,100"
info=$(brightnessctl -m 2>/dev/null || brightnessctl info)
notify "$info"
