#!/bin/sh
# 音量：vol up|down|mute（dwm / tmux / 命令行复用；通知图标为 Nerd Font）
set -e
step=5%

# Nerd Font (Material Design): volume-off / low / medium / high
icon_mute="󰝟"
icon_low="󰕿"
icon_mid="󰖀"
icon_high="󰕾"

notify() {
	command -v notify-send >/dev/null 2>&1 || return 0
	notify-send -r 9910 -t 1200 -a vol "$1" "$2"
}

case "${1:-}" in
up)
	wpctl set-volume @DEFAULT_AUDIO_SINK@ "${step}+"
	;;
down)
	wpctl set-volume @DEFAULT_AUDIO_SINK@ "${step}-"
	;;
mute)
	wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
	;;
*)
	echo "用法: $(basename "$0") up|down|mute" >&2
	exit 1
	;;
esac

raw=$(wpctl get-volume @DEFAULT_AUDIO_SINK@)
# "Volume: 0.55" 或 "Volume: 0.55 [MUTED]"
pct=$(printf '%s' "$raw" | awk '{printf "%d", $2 * 100}')
case "$raw" in
*[MUTED]*)
	icon=$icon_mute
	body="${pct}% muted"
	;;
*)
	if [ "$pct" -le 0 ]; then
		icon=$icon_mute
	elif [ "$pct" -lt 34 ]; then
		icon=$icon_low
	elif [ "$pct" -lt 67 ]; then
		icon=$icon_mid
	else
		icon=$icon_high
	fi
	body="${pct}%"
	;;
esac

printf '%s %s\n' "$icon" "$body"
notify "$icon" "$body"
# dwmblocks config.h：sb-volume signal 4 → RTMIN+4
pkill -RTMIN+4 dwmblocks 2>/dev/null || true
