#!/bin/sh
# dwmblocks：时间 — 图标色底 + 时刻；展开含日期
# 切换：sb-datetime toggle

icon_clock='󰥔'
icon_cal='󰃭'
# 图标底：Gruvbox Material yellow（替代原粉紫 #b16286）
pill='^c#282828^^b#d8a657^'
end='^d^'

cache_dir=${XDG_CACHE_HOME:-${HOME:-/tmp}/.cache}
mkdir -p "$cache_dir" 2>/dev/null || cache_dir=/tmp
cache=$cache_dir/sb-datetime.expand

toggle() {
	if [ -f "$cache" ]; then
		rm -f "$cache"
	else
		if ! : >"$cache" 2>/dev/null; then
			cache=/tmp/sb-datetime.expand
			: >"$cache"
		fi
	fi
}

case "${1:-}" in
toggle)
	toggle
	pkill -RTMIN+2 dwmblocks 2>/dev/null || true
	exit 0
	;;
esac

if [ -n "${BLOCK_BUTTON:-}" ]; then
	toggle
fi

if [ -f "$cache" ]; then
	printf '%s %s %s %s' "$pill" "$icon_cal" "$end" "$(date '+%A %m-%d %H:%M:%S')"
else
	printf '%s %s %s %s' "$pill" "$icon_clock" "$end" "$(date '+%H:%M:%S')"
fi
