#!/bin/sh
# dwmblocks：Caps 开 → 仍「英」但黄底；拼单独色；五与普通英同底（status2d）

fmt_caps='^c#282828^^b#d79921^ 英 ^d^'
fmt_en='^c#ebdbb2^^b#504945^ 英 ^d^'
fmt_py='^c#282828^^b#83a598^ 拼 ^d^'
fmt_wb='^c#ebdbb2^^b#504945^ 五 ^d^'

# 勿用整段匹配 " on"：同一行还有 Num Lock
if command -v xset >/dev/null 2>&1 \
	&& xset q 2>/dev/null | grep -Eq 'Caps Lock:[[:space:]]+on'; then
	printf '%s' "$fmt_caps"
	exit 0
fi

im=$(fcitx5-remote -n 2>/dev/null) || true
case "$im" in
*pinyin*|*Pinyin*)
	printf '%s' "$fmt_py"
	;;
*wbpy*|*wubi*|*Wubi*|*WBPY*)
	printf '%s' "$fmt_wb"
	;;
*)
	printf '%s' "$fmt_en"
	;;
esac
