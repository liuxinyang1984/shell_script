#!/bin/sh
# dwmblocks：电池 — 图标色底（随电量）+ 百分比
# 充电 󰂄、满电 󰚥、放电按档位

bat=
for d in /sys/class/power_supply/BAT*; do
	[ -d "$d" ] || continue
	bat=$d
	break
done
[ -n "$bat" ] || exit 0

stat=$(cat "$bat/status" 2>/dev/null) || stat=Unknown

cap=
if [ -r "$bat/charge_now" ] && [ -r "$bat/charge_full" ]; then
	now=$(cat "$bat/charge_now")
	full=$(cat "$bat/charge_full")
	if [ "$full" -gt 0 ] 2>/dev/null; then
		cap=$((now * 100 / full))
	fi
elif [ -r "$bat/energy_now" ] && [ -r "$bat/energy_full" ]; then
	now=$(cat "$bat/energy_now")
	full=$(cat "$bat/energy_full")
	if [ "$full" -gt 0 ] 2>/dev/null; then
		cap=$((now * 100 / full))
	fi
fi
[ -n "$cap" ] || cap=$(cat "$bat/capacity" 2>/dev/null) || exit 0

if [ "$cap" -gt 100 ] 2>/dev/null; then
	cap=100
fi
case "$stat" in
Full) cap=100 ;;
esac

case "$stat" in
Charging)
	icon='󰂄'
	;;
Full|"Not charging")
	icon='󰚥'
	;;
*)
	if [ "$cap" -ge 95 ] 2>/dev/null; then
		icon='󰁹'
	elif [ "$cap" -ge 80 ] 2>/dev/null; then
		icon='󰂁'
	elif [ "$cap" -ge 65 ] 2>/dev/null; then
		icon='󰁿'
	elif [ "$cap" -ge 50 ] 2>/dev/null; then
		icon='󰁾'
	elif [ "$cap" -ge 35 ] 2>/dev/null; then
		icon='󰁽'
	elif [ "$cap" -ge 20 ] 2>/dev/null; then
		icon='󰁼'
	elif [ "$cap" -ge 10 ] 2>/dev/null; then
		icon='󰁻'
	else
		icon='󰁺'
	fi
	;;
esac

# 色底：充电 aqua；否则绿/黄/橙/红
end='^d^'
case "$stat" in
Charging)
	pill='^c#282828^^b#458588^'
	;;
*)
	if [ "$cap" -ge 80 ] 2>/dev/null; then
		pill='^c#282828^^b#98971a^'
	elif [ "$cap" -ge 50 ] 2>/dev/null; then
		pill='^c#282828^^b#d79921^'
	elif [ "$cap" -ge 20 ] 2>/dev/null; then
		pill='^c#282828^^b#d65d0e^'
	else
		pill='^c#ebdbb2^^b#cc241d^'
	fi
	;;
esac

printf '%s %s %s %s%%' "$pill" "$icon" "$end" "$cap"
